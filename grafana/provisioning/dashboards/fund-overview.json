      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://mongo-api:4000/returns?plan_ids=21,22,23&period=1y&format=flat",
          "url_options": { "method": "GET" },
          "columns": [
            { "selector": "date",    "text": "Date",    "type": "datetime" },
            { "selector": "plan_21", "text": "Plan 21", "type": "number" },
            { "selector": "plan_22", "text": "Plan 22", "type": "number" },
