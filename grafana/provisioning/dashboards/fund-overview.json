{
  "__inputs": [],
  "__requires": [
    { "type": "grafana", "id": "grafana", "name": "Grafana", "version": "10.0.0" },
    { "type": "datasource", "id": "yesoreyeram-infinity-datasource", "name": "Infinity", "version": "1.0.0" }
  ],
  "annotations": { "list": [] },
  "description": "Fund NAV data from NyxDB.funds__fund_plan_daily_navs via mongo-api REST layer + Infinity datasource",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3b82f6", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto" },
      "title": "Total NAV Records",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://mongo-api:4000/aggregate/funds__fund_plan_daily_navs",
          "url_options": { "method": "POST", "data": "{\"pipeline\":[{\"$count\":\"total\"}]}" },
          "columns": [{ "selector": "total", "text": "Total", "type": "number" }]
        }
      ]
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#8b5cf6", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 4,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Unique Plans",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://mongo-api:4000/aggregate/funds__fund_plan_daily_navs",
          "url_options": { "method": "POST", "data": "{\"pipeline\":[{\"$group\":{\"_id\":\"$plan_id\"}},{\"$count\":\"total\"}]}" },
          "columns": [{ "selector": "total", "text": "Plans", "type": "number" }]
        }
      ]
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
