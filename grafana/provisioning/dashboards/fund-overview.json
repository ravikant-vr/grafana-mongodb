        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 12, "spanNulls": false },
          "unit": "none"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "NAV" }, "properties": [{ "id": "color", "value": { "fixedColor": "#3b82f6", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Adjusted NAV" }, "properties": [{ "id": "color", "value": { "fixedColor": "#8b5cf6", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 4 },
      "id": 2,
      "options": {
        "legend": { "calcs": ["last", "min", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
      "title": "NAV Trend — Plan 13 (NyxDB)",
      "type": "timeseries",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://mongo-api:4000/aggregate/funds__fund_plan_daily_navs",
          "url_options": {
            "method": "POST",
            "data": "{\"pipeline\":[{\"$match\":{\"plan_id\":21}},{\"$sort\":{\"as_on_date\":-1}},{\"$limit\":60},{\"$sort\":{\"as_on_date\":1}},{\"$addFields\":{\"date\":{\"$toDate\":\"$as_on_date\"}}},{\"$project\":{\"_id\":0,\"date\":1,\"nav\":1,\"adjusted_nav\":1}}]}"
          },
          "columns": [
            { "selector": "date", "text": "Date", "type": "datetime" },
            { "selector": "nav", "text": "NAV", "type": "number" },
            { "selector": "adjusted_nav", "text": "Adjusted NAV", "type": "number" }
          ]
        }
      ]
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 14 },
      "id": 3,
      "options": {
        "legend": { "calcs": ["last"], "displayMode": "table", "placement": "right" },
        "tooltip": { "mode": "multi" },
        "xTickLabelRotation": -45,
        "xTickLabelSpacing": 100
      },
      "title": "Latest NAV by Plan (NyxDB)",
      "type": "barchart",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://mongo-api:4000/aggregate/funds__fund_plan_daily_navs",
          "url_options": {
            "method": "POST",
            "data": "{\"pipeline\":[{\"$sort\":{\"as_on_date\":-1}},{\"$group\":{\"_id\":\"$plan_id\",\"latest_nav\":{\"$first\":\"$nav\"}}},{\"$sort\":{\"_id\":1}},{\"$limit\":20}]}"
          },
          "columns": [
            { "selector": "_id", "text": "Plan ID", "type": "string" },
            { "selector": "latest_nav", "text": "Latest NAV", "type": "number" }
          ]
        }
      ]
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 14 },
      "id": 5,
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "title": "NAV Distribution by Plan (Pie) — NyxDB",
      "type": "piechart",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
          "type": "json",
          "source": "url",
          "format": "table",
          "url": "http://mongo-api:4000/aggregate/funds__fund_plan_daily_navs",
          "url_options": {
            "method": "POST",
            "data": "{\"pipeline\":[{\"$sort\":{\"as_on_date\":-1}},{\"$group\":{\"_id\":\"$plan_id\",\"latest_nav\":{\"$first\":\"$nav\"}}},{\"$sort\":{\"_id\":1}},{\"$limit\":10}]}"
          },
          "columns": [
            { "selector": "_id", "text": "Plan", "type": "string" },
            { "selector": "latest_nav", "text": "NAV", "type": "number" }
          ]
        }
      ]
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "palette-classic" },
          "custom": { "lineWidth": 2, "fillOpacity": 8, "spanNulls": false },
          "unit": "percent"
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Plan 21" }, "properties": [{ "id": "color", "value": { "fixedColor": "#1a44d0", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Plan 22" }, "properties": [{ "id": "color", "value": { "fixedColor": "#166534", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "Plan 23" }, "properties": [{ "id": "color", "value": { "fixedColor": "#8b1a1a", "mode": "fixed" } }] }
        ]
      },
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 23 },
      "id": 6,
      "options": {
        "legend": { "calcs": ["last", "min", "max"], "displayMode": "table", "placement": "bottom" },
        "tooltip": { "mode": "multi" }
      },
