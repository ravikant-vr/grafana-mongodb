  ],
  "annotations": { "list": [] },
  "description": "NyxDB fund analytics — fund masters, daily NAVs, performance snapshots, category distribution",
  "editable": true,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#3b82f6", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "textMode": "auto" },
      "title": "Total Fund Masters",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
          "type": "json", "source": "url", "format": "table",
          "url": "http://mongo-api:4000/aggregate/funds__fund_masters",
          "url_options": { "method": "POST", "data": "{\"pipeline\":[{\"$count\":\"total\"}]}" },
          "columns": [{ "selector": "total", "text": "Funds", "type": "number" }]
        }
      ]
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#10b981", "value": null }] }
        },
        "overrides": []
      },
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "id": 6,
      "options": { "colorMode": "background", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "Unique NAV Plans",
      "type": "stat",
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
          "type": "json", "source": "url", "format": "table",
          "url": "http://mongo-api:4000/aggregate/funds__fund_plan_daily_navs",
          "url_options": { "method": "POST", "data": "{\"pipeline\":[{\"$group\":{\"_id\":\"$plan_id\"}},{\"$count\":\"total\"}]}" },
          "columns": [{ "selector": "total", "text": "Plans", "type": "number" }]
        }
      ]
    },
    {
      "datasource": { "type": "yesoreyeram-infinity-datasource", "uid": "mongodb-api-ds" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" }, "unit": "short",
          "thresholds": { "mode": "absolute", "steps": [{ "color": "#f59e0b", "value": null }] }
